{
  "manifest_version": 3,
  "name": "君斗りんくの追憶のきらめき",
  "version": "0.1.1534",
  "key": "",
  "description": "ニコニコ生放送の応援コメントをこのPCに記録し、応援の可視化につなげます（開発識別子: nicolivelog）。",
  "icons": {
    "16": "images/logo/konta-yukkuri-icon-16.png",
    "32": "images/logo/konta-yukkuri-icon-32.png",
    "48": "images/logo/konta-yukkuri-icon-48.png",
    "128": "images/logo/konta-yukkuri-icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "downloads",
    "alarms",
    "tabs",
    "webNavigation",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.nicovideo.jp/*",
    "https://app.tsuioku-no-kirameki.com/*",
    "https://suggestqueries.google.com/*",
    "http://127.0.0.1:50021/*",
    "http://127.0.0.1:3456/*",
    "http://localhost:3456/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://*.nicovideo.jp;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "君斗りんくの追憶のきらめき",
    "default_icon": {
      "16": "images/logo/konta-yukkuri-icon-16.png",
      "32": "images/logo/konta-yukkuri-icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.nicovideo.jp/*",
        "http://127.0.0.1:3456/*",
        "http://localhost:3456/*"
      ],
      "js": [
        "dist/page-intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://*.nicovideo.jp/*",
        "http://127.0.0.1:3456/*",
        "http://localhost:3456/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "data/ouen-banner.json",
        "status.html",
        "comeview.html",
        "dist/popup.js",
        "dist/status.js",
        "dist/comeview.js",
        "images/toumeilink.png",
        "images/avatar-parts/*",
        "images/yukkuri-charactore-english/*/*.png",
        "sound/voice-complete.mp3",
        "sound/voice-watch.mp3",
        "sound/effect-gift.mp3",
        "sound/effect-ad.mp3",
        "sound/effect-rank-up.mp3",
        "sound/effect-rank-down.mp3",
        "sound/effect-milestone-soft.mp3",
        "sound/effect-milestone-hard.mp3",
        "sound/effect-milestone-jackpot.mp3",
        "sound/tiers/*.mp3",
        "sound/custom/*"
      ],
      "matches": [
        "https://*.nicovideo.jp/*",
        "http://127.0.0.1:3456/*",
        "http://localhost:3456/*"
      ]
    }
  ]
}
