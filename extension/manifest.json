{
  "manifest_version": 3,
  "name": "君斗りんくの追憶のきらめき",
  "version": "0.1.2107",
  "key": "",
  "description": "ニコ生・YouTube・Twitch・Kick・ふわっち・SHOWROOM・ミクチャ・TikTok・ABEMA・ツイキャスの応援コメントをこのPCに記録し、配信後に振り返れます（開発識別子: nicolivelog）。",
  "icons": {
    "16": "images/logo/konta-yukkuri-icon-16.png",
    "32": "images/logo/konta-yukkuri-icon-32.png",
    "48": "images/logo/konta-yukkuri-icon-48.png",
    "128": "images/logo/konta-yukkuri-icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "downloads",
    "alarms",
    "tabs",
    "webNavigation",
    "sidePanel",
    "offscreen",
    "tts",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.nicovideo.jp/*",
    "https://app.tsuioku-no-kirameki.com/*",
    "https://suggestqueries.google.com/*",
    "https://www.youtube.com/*",
    "https://yt3.ggpht.com/*",
    "https://yt4.ggpht.com/*",
    "https://yt3.googleusercontent.com/*",
    "https://www.twitch.tv/*",
    "https://kick.com/*",
    "https://whowatch.tv/*",
    "https://api.whowatch.tv/*",
    "https://www.showroom-live.com/*",
    "https://mixch.tv/*",
    "https://www.tiktok.com/*",
    "https://abema.tv/*",
    "https://twitcasting.tv/*",
    "https://d2uqarpmf42qy0.cloudfront.net/*",
    "http://127.0.0.1:50021/*",
    "http://127.0.0.1:3456/*",
    "http://localhost:3456/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://*.nicovideo.jp https://www.youtube.com;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "君斗りんくの追憶のきらめき",
    "default_icon": {
      "16": "images/logo/konta-yukkuri-icon-16.png",
      "32": "images/logo/konta-yukkuri-icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.nicovideo.jp/*",
        "http://127.0.0.1:3456/*",
        "http://localhost:3456/*"
      ],
      "js": [
        "dist/page-intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://*.nicovideo.jp/*",
        "http://127.0.0.1:3456/*",
        "http://localhost:3456/*"
      ],
      "js": [
        "dist/content-boot.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "dist/yt-content-chat-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "dist/yt-content-chat.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "dist/yt-page-boot.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "dist/yt-tw-content.js",
        "dist/yt-page-boot.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://kick.com/*"
      ],
      "js": [
        "dist/yt-kick-content.js",
        "dist/yt-page-boot.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://whowatch.tv/*"
      ],
      "js": [
        "dist/yt-ww-content.js",
        "dist/yt-page-boot.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.showroom-live.com/*"
      ],
      "js": [
        "dist/yt-sr-content.js",
        "dist/yt-page-boot.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://mixch.tv/*"
      ],
      "js": [
        "dist/yt-mx-content.js",
        "dist/yt-page-boot.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://twitcasting.tv/*"
      ],
      "js": [
        "dist/yt-tc-content.js",
        "dist/yt-venue-inline.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "dist/yt-tt-main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "dist/yt-tt-content.js",
        "dist/yt-page-boot.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://abema.tv/*"
      ],
      "js": [
        "dist/yt-ab-main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://abema.tv/*"
      ],
      "js": [
        "dist/yt-ab-content.js",
        "dist/yt-page-boot.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "data/ouen-banner.json",
        "status.html",
        "comeview.html",
        "dist/popup.js",
        "dist/status.js",
        "dist/comeview.js",
        "images/toumeilink.png",
        "images/avatar-parts/*",
        "images/yukkuri-charactore-english/*/*.png",
        "sound/voice-complete.mp3",
        "sound/voice-watch.mp3",
        "sound/effect-gift.mp3",
        "sound/effect-ad.mp3",
        "sound/effect-rank-up.mp3",
        "sound/effect-rank-down.mp3",
        "sound/effect-milestone-soft.mp3",
        "sound/effect-milestone-hard.mp3",
        "sound/effect-milestone-jackpot.mp3",
        "sound/tiers/*.mp3",
        "sound/custom/*"
      ],
      "matches": [
        "https://*.nicovideo.jp/*",
        "http://127.0.0.1:3456/*",
        "http://localhost:3456/*"
      ]
    },
    {
      "resources": [
        "data/ouen-banner.json",
        "yt-comeview.html",
        "images/toumeilink.png",
        "images/avatar-parts/*",
        "images/yukkuri-charactore-english/*/*.png",
        "sound/voice-complete.mp3",
        "sound/voice-watch.mp3",
        "sound/effect-gift.mp3",
        "sound/effect-ad.mp3",
        "sound/effect-rank-up.mp3",
        "sound/effect-rank-down.mp3",
        "sound/effect-milestone-soft.mp3",
        "sound/effect-milestone-hard.mp3",
        "sound/effect-milestone-jackpot.mp3",
        "sound/tiers/*.mp3",
        "sound/custom/*"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.twitch.tv/*",
        "https://kick.com/*",
        "https://whowatch.tv/*",
        "https://www.showroom-live.com/*",
        "https://mixch.tv/*",
        "https://www.tiktok.com/*",
        "https://abema.tv/*",
        "https://twitcasting.tv/*"
      ]
    }
  ]
}
