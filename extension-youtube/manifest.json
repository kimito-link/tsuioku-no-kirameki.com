{
  "manifest_version": 3,
  "name": "追憶のきらめき for YouTube（試作）",
  "version": "0.1.0",
  "description": "YouTube Live のチャット・スーパーチャット・メンバーをローカル記録し、3つのレーンと通貨別応援者ランキング、VOICEVOXによる人ごとの声で振り返る試作拡張機能。",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:50021/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "追憶のきらめき for YouTube（試作）"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/live_chat_replay*",
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "content-chat.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
