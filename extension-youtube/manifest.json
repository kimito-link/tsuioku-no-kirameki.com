{
  "manifest_version": 3,
  "name": "追憶のきらめき for YouTube（試作）",
  "version": "0.1.113",
  "description": "YouTube Live のチャット・スーパーチャット・メンバーをローカル記録し、3つのレーンと通貨別応援者ランキング、VOICEVOXによる人ごとの声で振り返る試作拡張機能。",
  "icons": {
    "16": "images/logo/konta-yukkuri-icon-16.png",
    "32": "images/logo/konta-yukkuri-icon-32.png",
    "48": "images/logo/konta-yukkuri-icon-48.png",
    "128": "images/logo/konta-yukkuri-icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "sidePanel",
    "offscreen",
    "tts",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://yt3.ggpht.com/*",
    "https://yt4.ggpht.com/*",
    "https://yt3.googleusercontent.com/*",
    "http://127.0.0.1:50021/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "追憶のきらめき for YouTube（試作）",
    "default_icon": {
      "16": "images/logo/konta-yukkuri-icon-16.png",
      "32": "images/logo/konta-yukkuri-icon-32.png",
      "48": "images/logo/konta-yukkuri-icon-48.png",
      "128": "images/logo/konta-yukkuri-icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "js": [
        "content-chat-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content-chat.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "venue-inline.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/ouen-banner.json",
        "comeview.html",
        "images/toumeilink.png",
        "images/avatar-parts/*",
        "images/yukkuri-charactore-english/*/*.png",
        "sound/voice-complete.mp3",
        "sound/voice-watch.mp3",
        "sound/effect-gift.mp3",
        "sound/effect-ad.mp3",
        "sound/effect-rank-up.mp3",
        "sound/effect-rank-down.mp3",
        "sound/effect-milestone-soft.mp3",
        "sound/effect-milestone-hard.mp3",
        "sound/effect-milestone-jackpot.mp3",
        "sound/tiers/*.mp3",
        "sound/custom/*"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
