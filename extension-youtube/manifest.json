{
  "manifest_version": 3,
  "name": "追憶のきらめき for YouTube（試作）",
  "version": "0.1.11",
  "description": "YouTube Live のチャット・スーパーチャット・メンバーをローカル記録し、3つのレーンと通貨別応援者ランキング、VOICEVOXによる人ごとの声で振り返る試作拡張機能。",
  "icons": {
    "16": "images/logo/konta-yukkuri-icon-16.png",
    "32": "images/logo/konta-yukkuri-icon-32.png",
    "48": "images/logo/konta-yukkuri-icon-48.png",
    "128": "images/logo/konta-yukkuri-icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "sidePanel",
    "offscreen",
    "tts"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:50021/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "追憶のきらめき for YouTube（試作）",
    "default_icon": {
      "16": "images/logo/konta-yukkuri-icon-16.png",
      "32": "images/logo/konta-yukkuri-icon-32.png",
      "48": "images/logo/konta-yukkuri-icon-48.png",
      "128": "images/logo/konta-yukkuri-icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content-chat.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
