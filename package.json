{
  "name": "nicolivelog",
  "version": "0.1.908",
  "private": true,
  "description": "ニコ生コメント記録プロトタイプ（拡張）",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:cc": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run lint && npm run typecheck && npm run build",
    "verify:cc": "node scripts/run-verify-cc.mjs",
    "verify:bump": "node scripts/verify-bump.mjs",
    "setup:claude": "node scripts/setup-claude-code.mjs",
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build-watch.mjs",
    "copy:ext": "node scripts/copy-ext.mjs",
    "build:copy": "node scripts/build.mjs && node scripts/copy-ext.mjs",
    "feature-map": "node scripts/feature-map.mjs",
    "feature-map:check": "node scripts/feature-map.mjs --check",
    "impact-check": "node scripts/impact-check.mjs",
    "tree-map": "node scripts/repo-tree-map.mjs",
    "tree-map:check": "node scripts/repo-tree-map.mjs --check",
    "site-health": "node scripts/site-health.mjs",
    "site-health:check": "node scripts/site-health.mjs --check",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "test:e2e:headed": "npm run build && node scripts/run-e2e.mjs --headed",
    "test:e2e:smoke": "npm run build && node scripts/run-e2e.mjs --headed tests/e2e/smoke.spec.js",
    "test:e2e:monkey": "npm run build && node scripts/run-e2e.mjs --headed tests/e2e/popup-monkey.spec.js",
    "test:e2e:smoke-monkey": "npm run build && node scripts/run-e2e.mjs --headed tests/e2e/smoke.spec.js tests/e2e/popup-monkey.spec.js",
    "test:e2e:interaction": "npm run build && node scripts/run-e2e.mjs --headed tests/e2e/extension-interaction.spec.js",
    "test:e2e:ui": "npm run build && npx playwright test --ui",
    "test:e2e:lp": "npx playwright test --config=playwright.lp.config.js",
    "test:e2e:ci": "npx playwright test",
    "playwright:install": "playwright install chromium",
    "council:cleanup": "node scripts/council-cleanup.mjs",
    "inspect:watch-stats": "node scripts/inspect-nicolive-watch-stats.mjs",
    "vendor:visual-explainer": "node scripts/vendor-visual-explainer.mjs",
    "gen:marketing-avatars": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/resize-marketing-html-avatars.ps1 && node scripts/encode-marketing-html-avatars.mjs",
    "sync:lp-twitter-icon": "node scripts/sync-lp-twitter-icon.mjs",
    "lp:serve": "python -m http.server 3780 --bind 127.0.0.1",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.51.0",
    "@types/chrome": "^0.1.39",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "serve": "^14.2.4",
    "typescript": "^6.0.2",
    "vitest": "^3.0.0"
  }
}
